# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# cloudflare workers (OpenNext adapter)
/.open-next/
/.wrangler/
cloudflare-env.d.ts
.dev.vars

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example

# temp dev server logs
dev*.log
*.log
.sbp-token
backups/

# Supabase CLI local state (project refs, versions) — never commit
supabase/.temp/

# Local demo backup wiped from prod 2026-10-03 — stays on disk, out of git
_archive/

# Local prospecting artifacts (internal, never shipped) — contains contact PII, keep out of git
/_prospects/
/_*.js
/_*.json
/_*.txt
