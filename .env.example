# Veyra — environment configuration
# Copy to .env.local and fill in. Everything is optional at this stage:
# without Supabase vars the lead-capture form works in local mode, and
# without Razorpay vars the checkout page shows a clear "payments not
# yet configured" state instead of breaking.

# Canonical site origin (used for SEO metadata, sitemap, structured data).
# Set this to your production domain when deployed.
NEXT_PUBLIC_SITE_URL=https://veyra.co

# Supabase — run supabase/migrations/0001_leads.sql, 0002_orders.sql, and
# 0003_customer_accounts.sql (in order) in the SQL editor first.
# Project Settings → API → Project URL / anon public key / service_role secret.
# Orders and payment verification require the URL + service role key.
# Customer accounts (sign in / account area) additionally require the
# anon public key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth — confirmation/verification emails use the project's
# built-in email service. Configure a custom sender under
# Project Settings → Auth before going live.

# Razorpay — payment initiation (Stage 02). Get these from the Razorpay
# Dashboard → Settings → API Keys. The secret key NEVER reaches the browser;
# only the public key id does, served to the checkout page by the
# order-creation API. Test keys start with rzp_test_…; use them until
# going live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay — webhook signature verification. Set this from the Razorpay
# Dashboard → Settings → Webhooks (create a webhook for
# https://your-domain/api/webhooks/razorpay with events payment.captured
# and payment.failed; Razorpay shows the secret once at creation).
# Until it is set, the webhook endpoint answers 503 and processes nothing.
RAZORPAY_WEBHOOK_SECRET=

# Admin Command Center (Stage 05) — the /admin gate. Server-side only;
# NEVER prefixed NEXT_PUBLIC_. Rotate to a strong unique value before
# production. Optionally set VEYRA_ADMIN_SESSION_SECRET (a long random
# string) so sessions survive password rotation and signing is
# independent from the credential.
VEYRA_ADMIN_PASSWORD=
VEYRA_ADMIN_SESSION_SECRET=
