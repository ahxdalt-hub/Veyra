# Veyra — environment configuration
# Copy to .env.local and fill in. Everything is optional at this stage:
# without Supabase vars the lead-capture form works in local mode, and
# without Lemon Squeezy vars the checkout page shows a clear "payments not
# yet configured" state instead of breaking.

# Canonical site origin (used for SEO metadata, sitemap, structured data).
# Set this to your production domain when deployed.
NEXT_PUBLIC_SITE_URL=https://veyra.caelmont.in

# Parent company (Caelmont) origin — used for the footer/nav "Partners" link
# into the Caelmont Partner Program. Falls back to https://caelmont.in.
NEXT_PUBLIC_PARENT_SITE_URL=https://caelmont.in

# Supabase — run supabase/migrations/0001_leads.sql, 0002_orders.sql, and
# 0003_customer_accounts.sql (in order) in the SQL editor first.
# Project Settings → API → Project URL / anon public key / service_role secret.
# Orders and payment verification require the URL + service role key.
# Customer accounts (sign in / account area) additionally require the
# anon public key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth — confirmation/verification emails use the project's
# built-in email service. Configure a custom sender under
# Project Settings → Auth before going live.

# Lemon Squeezy — payment processing, hosted checkout, TEST MODE.
# The server creates a hosted checkout per order (custom_price carries
# Veyra's server-side seat-tier + coupon amount); the customer pays on
# Lemon Squeezy's page; the signed order_created webhook confirms it.
# LEMONSQUEEZY_API_KEY is the API key (a JWT) from
# Lemon Squeezy → Developer settings. Server-side ONLY — never prefixed
# NEXT_PUBLIC_, never committed. Generate it with the store's Test Mode
# toggle ON while testing; swap in the live-mode key at launch.
# LEMONSQUEEZY_STORE_ID is the numeric store id, also from Developer settings.
# LEMONSQUEEZY_VARIANT_ID_<SLUG>: one variant id per purchasable product
# (Lemon Squeezy → product → variants). Create a plain one-time product per
# catalog entry; the price on the variant doesn't matter — custom_price
# overrides it. The slug is upper-cased with '-' → '_':
#   LEMONSQUEEZY_VARIANT_ID_CLIENT_GROWTH_SYSTEM=
#   LEMONSQUEEZY_VARIANT_ID_GROWTH_AUDIT=
# LEMONSQUEEZY_MODE declares which store mode is wired: "test" (default)
# or "live". It is display-only honesty (checkout banner, admin settings) —
# the key itself decides what can actually be charged.
# PAYMENT_PROVIDER decides — explicitly — which gateway checkout uses:
#   PAYMENT_PROVIDER=lemonsqueezy  → Lemon Squeezy ONLY (production).
#   PAYMENT_PROVIDER=razorpay      → Razorpay ONLY.
# Unset defaults to lemonsqueezy. Any other value fails closed (checkout
# refuses with a misconfiguration error) — a typo must never silently pick
# a provider. Razorpay keys being present does NOT reroute checkout.
PAYMENT_PROVIDER=lemonsqueezy

LEMONSQUEEZY_MODE=test
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID_CLIENT_GROWTH_SYSTEM=
LEMONSQUEEZY_VARIANT_ID_GROWTH_AUDIT=

# Lemon Squeezy — webhook signature verification. Set this from the
# Lemon Squeezy Dashboard → Store → Settings → Webhooks → Add webhook:
# URL https://your-domain/api/webhooks/lemonsqueezy, events "Order created"
# and "Order refunded", with the signing secret you choose (6–40 chars).
# The secret HMAC-SHA256-hashes the RAW request body (X-Signature header).
# Until it is set, the webhook endpoint answers 503 and processes nothing.
LEMONSQUEEZY_WEBHOOK_SECRET=

# Razorpay — optional TEST provider (0022). Leave empty in production.
# Keys alone do NOT activate it: set PAYMENT_PROVIDER=razorpay (above) AND
# provide the key pair. Then the server creates the Razorpay order, the
# browser opens Razorpay Checkout, and /api/checkout/razorpay/verify
# re-verifies the signature AND the payment against Razorpay's API before
# an order turns paid. Switch PAYMENT_PROVIDER back to lemonsqueezy to
# return to the production path — the keys may stay in place, ignored.
# RAZORPAY_CURRENCY overrides the charged currency for test accounts that
# only accept INR (test money — the amount number is unchanged). Leave
# empty to charge in the catalog currency.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=
# Optional. Set it from Razorpay Dashboard → Settings → Webhooks →
# + Add New Webhook (URL https://your-domain/api/webhooks/razorpay, events
# "order.paid" and "refund.processed"). The secret HMAC-SHA256-hashes the
# RAW request body (x-razorpay-signature header). Until it is set, the
# webhook endpoint answers 503 — local testing confirms through the verify
# route instead (localhost can't receive webhooks).
RAZORPAY_WEBHOOK_SECRET=

# Admin Command Center (/admin) — Supabase Auth based.
# The gate is the app_metadata.role === 'admin' flag on a Supabase Auth
# user — set it from the Dashboard (Authentication → Users → user →
# app_metadata) or via the Auth admin API with the service-role key:
#   curl -X PUT "$NEXT_PUBLIC_SUPABASE_URL/auth/v1/admin/users/<id>" \
#     -H "apikey: $SUPABASE_SERVICE_ROLE_KEY" \
#     -H "Authorization: Bearer $SUPABASE_SERVICE_ROLE_KEY" \
#     -H 'Content-Type: application/json' \
#     -d '{"app_metadata":{"role":"admin"}}'
# Admins then sign in at /admin/sign-in with their normal account email
# and password.
#
# Optional shared operator door: set all three to let a static
# username/password pair into the command center. A match mints a real
# Supabase session for the admin user named by VEYRA_ADMIN_EMAIL, so the
# JWT claim + service-role role checks still apply. Unset = no door.
# VEYRA_ADMIN_USERNAME=Admin
# VEYRA_ADMIN_PASSWORD=change-me
# VEYRA_ADMIN_EMAIL=owner@yourdomain.com

# ---------------------------------------------------------------------------
# Licensing (Stage 07) — commercial activation for desktop products.
#
# VEYRA_LICENCE_SIGNING_KEY: base64 of a PEM PKCS#8 ECDSA P-256 private key.
#   Server-side ONLY. Signs the local entitlement tokens the desktop app
#   verifies offline. Generate:
#     node -e "const c=require('crypto');const {publicKey,privateKey}=c.generateKeyPairSync('ec',{namedCurve:'prime256v1'});require('fs').writeFileSync('licence-private.pem',privateKey.export({type:'pkcs8',format:'pem'}));const j=publicKey.export({format:'jwk'});console.log(JSON.stringify({kty:'EC',crv:'P-256',x:j.x,y:j.y,use:'sig',alg:'ES256'}))"
#   then: SUPABASE env var = base64 of that PEM file's contents.
# VEYRA_LICENCE_PUBLIC_KEY_JWK: the matching public key (JWK JSON). This value
#   — and only this value — is embedded in the desktop app for verification.
#   When rotating the pair, update BOTH here and LICENCE_PUBLIC_KEY_JWK in
#   the Client Growth System repo, then ship a new app build.
SUPABASE_SERVICE_ROLE_KEY=
VEYRA_LICENCE_SIGNING_KEY=
VEYRA_LICENCE_PUBLIC_KEY_JWK=

# ---------------------------------------------------------------------------
# Delivery automation (Stage 08) — purchase → licence → email → download.
#
# SUPABASE_DELIVERY_BUCKET: private storage bucket holding installer
#   artifacts (object keys are recorded per release in product_versions.
#   artifact_key — publish them with scripts/publish-version.mjs).
#   Unset or empty = downloads honestly answer "being published".
SUPABASE_DELIVERY_BUCKET=

# RESEND_API_KEY: transactional email provider key (resend.com). Powers the
#   purchase/licence receipt. Server-side only. UNSET = emails render to the
#   server console instead of sending — every idempotency guarantee still
#   holds, the send is simply local.
RESEND_API_KEY=
# VEYRA_EMAIL_FROM: from-address on outgoing email, e.g.
#   "Veyra <Caelmontholdings@gmail.com>". Defaults to Veyra <Caelmontholdings@gmail.com>.
#   Resend only sends from addresses/domains verified on the account.
VEYRA_EMAIL_FROM=

# Vault pin for the command center sign-in (optional). When set (4-8
# digits), sign-in always asks for this code after the credentials: the
# server verifies credentials + pin together before minting the session.
# Unset = no vault stage.
# Pick your own and never commit the real value — the example once shipped
# with a real pin in this comment, which put it in git history.
# VEYRA_ADMIN_PIN=

# Caelmont partner attribution (src/lib/partner-attribution.ts).
#
# When a visitor arrives via a caelmont.in/r/<code> partner link, Veyra
# captures the opaque cm_ref marker, rides it through the Lemon Squeezy
# checkout, and POSTs a signed order.paid/order.refunded event to Caelmont so
# the referring partner is credited. All of this is best-effort and inert if
# the secret is unset — checkout, fulfillment and webhooks work normally
# without it.
#
# PARTNER_WEBHOOK_SECRET: HMAC key shared with Caelmont. It MUST be identical
#   to PARTNER_WEBHOOK_SECRET on the caelmont.in Worker, or Caelmont rejects
#   every event with 401 and no partner is ever credited. Server-side only.
#   Must be >= 32 chars (Caelmont fails closed on anything shorter).
#   On the deployed Worker: wrangler secret put PARTNER_WEBHOOK_SECRET
PARTNER_WEBHOOK_SECRET=
# CAELMONT_WEBHOOK_URL: where signed events go. Defaults to
#   https://caelmont.in/api/partners/webhook in code; set only to point at a
#   staging Caelmont. Not a secret (public URL) — safe as a plain wrangler var.
CAELMONT_WEBHOOK_URL=
