# Standard Practice — environment configuration
# Copy to .env.local and fill in. Everything is optional in Phase 1:
# without Supabase vars the lead-capture form works in local mode
# (submissions are logged server-side) so the site is fully functional.

# Canonical site origin (used for SEO metadata, sitemap, structured data).
# Set this to your production domain when deployed.
NEXT_PUBLIC_SITE_URL=https://standardpractice.co

# Supabase — run supabase/migrations/0001_leads.sql first.
# Project Settings → API → Project URL / service_role secret.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
