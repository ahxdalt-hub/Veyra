{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veyra",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  /*
   * Public hostname — https://veyra.caelmont.in.
   *
   * `custom_domain: true` makes this Worker the origin for that hostname:
   * Cloudflare creates and owns both the DNS record and the TLS certificate,
   * and re-attaching an already-attached hostname is a no-op — so this is safe
   * to leave in permanently and a deploy can never detach it by accident.
   *
   * `veyra.ahxd.workers.dev` is kept serving as well. It existed because an
   * earlier gateway could only reach the Workers subdomain; Dodo's webhook is
   * registered on the custom domain, so this is now only a link-compat
   * concern and can be retired at any time.
   */
  "routes": [
    { "pattern": "veyra.caelmont.in", "custom_domain": true }
  ],
  /*
   * MUST stay `true` until the workers.dev URL is confirmed unused. Wrangler
   * disables the subdomain by default when this key is absent, which silently
   * 404s `veyra.ahxd.workers.dev`. Dodo's webhook is registered on
   * veyra.caelmont.in, so nothing payment-critical depends on it anymore —
   * set it to `false` whenever you want the subdomain gone.
   */
  "workers_dev": true,
  "preview_urls": false,
  // Never drop bindings that were created outside this file (the worker's
  // secrets live in Cloudflare, not in the repo).
  "keep_vars": true,
  // Non-secret runtime configuration. Everything here is either a public
  // identifier (NEXT_PUBLIC_* values are shipped to browsers on purpose and
  // are protected by Supabase RLS) or a display-only mode flag. Anything
  // sensitive — SUPABASE_SERVICE_ROLE_KEY, VEYRA_LICENCE_SIGNING_KEY,
  // DODO_PAYMENTS_API_KEY, DODO_PAYMENTS_WEBHOOK_KEY, RESEND_API_KEY,
  // PARTNER_WEBHOOK_SECRET (shared with Caelmont's /api/partners/webhook —
  // MUST equal the value on caelmont.in or signed attribution events are
  // rejected with 401), and
  // the command-center vault set (VEYRA_ADMIN_USERNAME, VEYRA_ADMIN_PASSWORD,
  // VEYRA_ADMIN_EMAIL, VEYRA_ADMIN_PIN, VEYRA_ADMIN_SESSION_SECRET) — is
  // set with `wrangler secret put` / `wrangler secret bulk` and never
  // committed.
  "vars": {
    // Public Caelmont seam that receives signed order.paid/order.refunded
    // events for partner commissions (src/lib/partner-attribution.ts). Not a
    // secret — it is a public URL; the authentication is the HMAC signature.
    // Overridable per environment; the code defaults to production caelmont.in.
    "CAELMONT_WEBHOOK_URL": "https://caelmont.in/api/partners/webhook",
    "NEXT_PUBLIC_SITE_URL": "https://veyra.caelmont.in",
    "NEXT_PUBLIC_SUPABASE_URL": "https://otqucrqcefdychplbbtq.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im90cXVjcnFjZWZkeWNocGxiYnRxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkxMjA3MDksImV4cCI6MjEwNDY5NjcwOX0.k4lAS0BTHEqpi6GgVEymZK0-XCjLxYIsStBLxeFIs9g",
    "SUPABASE_DELIVERY_BUCKET": "product-downloads",
    // Explicit provider selection (see src/lib/payments/provider.ts). Only
    // "dodo" is accepted now — the Razorpay and Lemon Squeezy code paths are
    // removed, and any other value fails closed with payment_provider_invalid.
    // Dodo is a MERCHANT OF RECORD: it is the legal seller, it calculates and
    // remits sales tax/VAT, and "Dodo Payments" is what appears on the
    // customer's bank statement.
    "PAYMENT_PROVIDER": "dodo",
    // "test_mode" or "live_mode". Decides the API base URL
    // (test.dodopayments.com / live.dodopayments.com) and the mode banner.
    // Dodo API keys are mode-scoped, so this MUST match the bound
    // DODO_PAYMENTS_API_KEY — a live key with test_mode here 401s at checkout.
    // Held at test_mode: the live account is not enabled yet (Dodo business
    // verification returns MERCHANT_NOT_LIVE), so a live-mode deploy would
    // refuse every checkout. Flip when the live key is bound.
    "DODO_PAYMENTS_ENVIRONMENT": "test_mode",
    // One product id per PAID product, from the Dodo dashboard. Product ids
    // are public identifiers, not secrets, so they live here. Each product
    // MUST be "Pay What You Want" priced at $1.00, or Dodo ignores the amount
    // Veyra computes server-side and silently charges the stored price.
    // The Growth Audit is free — /api/claim never contacts a processor, so it
    // needs no product id. Fill this in or bind it with `wrangler secret put`;
    // `npm run dodo:setup` prints the exact lines.
    // Product ids are MODE-SCOPED: this is the test-mode product
    // ("Veyra Client Growth System", PWYW at $1.00 in USD, verified against
    // the test API on 2026-10-05). When Dodo live mode is enabled, create the
    // same product there and replace this id — a test id returns 404 from the
    // live API and checkout fails closed.
    "DODO_PAYMENTS_PRODUCT_ID_CLIENT_GROWTH_SYSTEM": "pdt_0Np5RynjbKvhYoRFnYtQj",
    // DODO_PAYMENTS_API_KEY and DODO_PAYMENTS_WEBHOOK_KEY are secrets and are
    // NOT here: `wrangler secret put DODO_PAYMENTS_API_KEY` etc. Without them
    // checkout refuses to start (payments_not_configured) instead of
    // mis-billing.
    // Sender for transactional email (checklist PDF, purchase receipts).
    // Currently the Resend SANDBOX sender — Resend only delivers it to the
    // account owner's inbox until a sending domain is verified at
    // resend.com/domains. Contact email is Caelmontholdings@gmail.com;
    // veyra.caelmont.in is verified at Resend, so the real sender is live.
    "VEYRA_EMAIL_FROM": "Veyra <no-reply@veyra.caelmont.in>",
    "VEYRA_LICENCE_PUBLIC_KEY_JWK": "{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"f4HKyrMbMIxqXVwYwKnpEt39hbLVIS2sMvP7g8WIdzg\",\"y\":\"IWqaev8f4P_3z_f1qduNDlCIeS-In0en3RNvgdFAgk0\"}"
  }
}