{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veyra",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  /*
   * Public hostname — https://veyra.caelmont.in.
   *
   * `custom_domain: true` makes this Worker the origin for that hostname:
   * Cloudflare creates and owns both the DNS record and the TLS certificate,
   * and re-attaching an already-attached hostname is a no-op — so this is safe
   * to leave in permanently and a deploy can never detach it by accident.
   *
   * `veyra.ahxd.workers.dev` is deliberately left serving as well: Lemon
   * Squeezy delivers payment webhooks to a URL configured in their dashboard,
   * and any existing links keep resolving. Retire it only after those have
   * been moved over.
   */
  "routes": [
    { "pattern": "veyra.caelmont.in", "custom_domain": true }
  ],
  /*
   * MUST stay `true`. Wrangler disables the workers.dev subdomain by default
   * when this key is absent, which silently 404s `veyra.ahxd.workers.dev` —
   * that is the origin Lemon Squeezy delivers payment webhooks to, so
   * disabling it drops orders. Only set this to `false` once the webhook URL
   * in the Lemon Squeezy dashboard has been repointed at veyra.caelmont.in.
   */
  "workers_dev": true,
  "preview_urls": false,
  // Never drop bindings that were created outside this file (the worker's
  // secrets live in Cloudflare, not in the repo).
  "keep_vars": true,
  // Non-secret runtime configuration. Everything here is either a public
  // identifier (NEXT_PUBLIC_* values are shipped to browsers on purpose and
  // are protected by Supabase RLS) or a display-only mode flag. Anything
  // sensitive — SUPABASE_SERVICE_ROLE_KEY, VEYRA_LICENCE_SIGNING_KEY,
  // LEMONSQUEEZY_API_KEY, LEMONSQUEEZY_WEBHOOK_SECRET, RESEND_API_KEY,
  // PARTNER_WEBHOOK_SECRET (shared with Caelmont's /api/partners/webhook —
  // MUST equal the value on caelmont.in or signed attribution events are
  // rejected with 401), and
  // the command-center vault set (VEYRA_ADMIN_USERNAME, VEYRA_ADMIN_PASSWORD,
  // VEYRA_ADMIN_EMAIL, VEYRA_ADMIN_PIN, VEYRA_ADMIN_SESSION_SECRET) — is
  // set with `wrangler secret put` / `wrangler secret bulk` and never
  // committed.
  "vars": {
    // Public Caelmont seam that receives signed order.paid/order.refunded
    // events for partner commissions (src/lib/partner-attribution.ts). Not a
    // secret — it is a public URL; the authentication is the HMAC signature.
    // Overridable per environment; the code defaults to production caelmont.in.
    "CAELMONT_WEBHOOK_URL": "https://caelmont.in/api/partners/webhook",
    "NEXT_PUBLIC_SITE_URL": "https://veyra.caelmont.in",
    "NEXT_PUBLIC_SUPABASE_URL": "https://otqucrqcefdychplbbtq.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im90cXVjcnFjZWZkeWNocGxiYnRxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkxMjA3MDksImV4cCI6MjEwNDY5NjcwOX0.k4lAS0BTHEqpi6GgVEymZK0-XCjLxYIsStBLxeFIs9g",
    "SUPABASE_DELIVERY_BUCKET": "product-downloads",
    // Explicit provider selection (see src/lib/payments/provider.ts).
    // "lemonsqueezy" is production; Razorpay keys never reroute checkout
    // unless this is changed to "razorpay".
    "PAYMENT_PROVIDER": "lemonsqueezy",
    "LEMONSQUEEZY_MODE": "test",
    "LEMONSQUEEZY_STORE_ID": "485404",
    // Sender for transactional email (checklist PDF, purchase receipts).
    // Currently the Resend SANDBOX sender — Resend only delivers it to the
    // account owner's inbox until a sending domain is verified at
    // resend.com/domains. Contact email is Caelmontholdings@gmail.com;
    // veyra.caelmont.in is verified at Resend, so the real sender is live.
    "VEYRA_EMAIL_FROM": "Veyra <no-reply@veyra.caelmont.in>",
    "VEYRA_LICENCE_PUBLIC_KEY_JWK": "{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"f4HKyrMbMIxqXVwYwKnpEt39hbLVIS2sMvP7g8WIdzg\",\"y\":\"IWqaev8f4P_3z_f1qduNDlCIeS-In0en3RNvgdFAgk0\"}"
  }
}