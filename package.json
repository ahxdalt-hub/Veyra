{
  "name": "veyra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/deploy.mjs",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:licensing": "node --test src/lib/licensing/token.test.ts && node --test supabase/test/activation.engine.test.mjs && node --test supabase/test/platform.delivery.test.mjs && node --test supabase/test/rate.limit.test.mjs",
    "test:pricing": "node --test src/lib/pricing.test.ts",
    "test:delivery:e2e": "node supabase/test/delivery.e2e.mjs",
    "dodo:setup": "node scripts/check-dodo-config.mjs",
    "test:dodo": "node --test src/lib/dodo-payments.test.ts",
    "test:payments:config": "node scripts/check-dodo-config.mjs",
    "test:payments:live": "node scripts/check-dodo-config.mjs --live",
    "test:email:config": "node scripts/check-email-config.mjs",
    "test:security:live": "node supabase/test/security.live.mjs",
    "test:attribution": "node --test supabase/test/partner.attribution.test.ts",
    "outreach": "node scripts/send-ig-dms-puppeteer.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.50.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@opentelemetry/api": "^1.9.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "critters": "^0.0.23",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.132.0"
  }
}
